{
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/Dashboard/frontend/html/loading.html"
    },
    {
      "source": "/dashboard/overview",
      "destination": "/Dashboard/frontend/html/overview.html"
    },
    {
      "source": "/dashboard/products",
      "destination": "/Dashboard/frontend/html/products.html"
    },
    {
      "source": "/dashboard/orders",
      "destination": "/Dashboard/frontend/html/orders.html"
    },
    {
      "source": "/dashboard/messages",
      "destination": "/Dashboard/frontend/html/messages.html"
    },
    {
      "source": "/dashboard/account",
      "destination": "/Dashboard/frontend/html/account.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/Dashboard/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/Store/frontend/images/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/Store/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/Store/frontend/js/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/Store/frontend/images/:path*"
    },
    {
      "source": "/pages/:path*",
      "destination": "/Store/frontend/html/:path*"
    },
    {
      "source": "/",
      "destination": "/Store/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/Store/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    }
  ]
}
